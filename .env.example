# Environment Configuration for ReqRipple

# Application
APP_NAME=ReqRipple
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-key

# Database
# For local SQLite MVP:
DATABASE_URL=sqlite:///./reqripple.db

# JWT Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
